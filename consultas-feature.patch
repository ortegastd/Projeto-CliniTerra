+<!DOCTYPE html>
+<html lang="pt-br">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Consultas Registradas - Projeto CliniTerra</title>
+    <style>
+        :root {
+            --marrom-escuro: #3E2723;
+            --marrom-claro: #8C391A;
+            --cinza-claro: #D3D3D3;
+            --branco: #FFFFFF;
+            --vermelho: #D32F2F;
+        }
+
+        body, html {
+            height: 100%;
+            margin: 0;
+            font-family: Arial, sans-serif;
+            background: linear-gradient(135deg, #973F2D 0%, #532A1B 100%);
+            background-attachment: fixed;
+            display: flex;
+            justify-content: center;
+            align-items: center;
+        }
+
+        .card-lista {
+            background-color: var(--marrom-escuro);
+            padding: 40px;
+            border-radius: 12px;
+            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
+            width: 100%;
+            max-width: 850px;
+            color: var(--branco);
+            text-align: center;
+            position: relative;
+        }
+
+        .link-voltar-painel {
+            display: inline-block;
+            color: var(--cinza-claro);
+            text-decoration: none;
+            font-size: 14px;
+            margin-bottom: 15px;
+            transition: color 0.3s;
+        }
+
+        .link-voltar-painel:hover {
+            color: var(--branco);
+            text-decoration: underline;
+        }
+
+        h2 {
+            margin-top: 0;
+            margin-bottom: 25px;
+            color: var(--cinza-claro);
+        }
+
+        table {
+            width: 100%;
+            border-collapse: collapse;
+            margin-bottom: 25px;
+            text-align: left;
+        }
+
+        th, td {
+            padding: 12px;
+            border-bottom: 1px solid rgba(211, 211, 211, 0.2);
+            font-size: 14px;
+        }
+
+        th {
+            color: var(--cinza-claro);
+            font-weight: bold;
+        }
+
+        td {
+            color: var(--branco);
+        }
+
+        .btn-excluir {
+            color: var(--vermelho);
+            text-decoration: none;
+            font-weight: bold;
+            font-size: 16px;
+            padding: 2px 8px;
+            border-radius: 4px;
+            transition: background-color 0.2s;
+        }
+
+        .btn-excluir:hover {
+            background-color: rgba(211, 47, 47, 0.2);
+        }
+
+        .btn-nova-consulta {
+            display: inline-block;
+            width: 100%;
+            padding: 12px;
+            background-color: var(--marrom-claro);
+            color: var(--branco);
+            border-radius: 6px;
+            font-weight: bold;
+            text-decoration: none;
+            box-sizing: border-box;
+            transition: background-color 0.3s, transform 0.2s;
+            text-align: center;
+            font-size: 14px;
+        }
+
+        .btn-nova-consulta:hover {
+            background-color: #BCAAA4;
+            color: var(--marrom-escuro);
+        }
+    </style>
+</head>
+<body>
+    <div class="card-lista">
+        <a href="{% url 'home' %}" class="link-voltar-painel">← Sair do Painel Administrativo</a>
+
+        <h2>Consultas Registradas</h2>
+
+        <table>
+            <thead>
+                <tr>
+                    <th>ID</th>
+                    <th>Paciente</th>
+                    <th>Tipo</th>
+                    <th>Data</th>
+                    <th>Hora</th>
+                    <th>Observações</th>
+                    <th style="text-align: center;">Ações</th>
+                </tr>
+            </thead>
+            <tbody>
+                {% for consulta in consultas %}
+                <tr>
+                    <td>{{ consulta.id_consulta }}</td>
+                    <td>{{ consulta.usuario.nome }}</td>
+                    <td>{{ consulta.get_tipo_display }}</td>
+                    <td>{{ consulta.data|date:"d/m/Y" }}</td>
+                    <td>{{ consulta.hora|time:"H:i" }}</td>
+                    <td>{{ consulta.observacoes|default:"—" }}</td>
+                    <td style="text-align: center;">
+                        <a href="{% url 'excluir_consulta' consulta.id_consulta %}" class="btn-excluir" onclick="return confirm('Deseja realmente excluir esta consulta?');">❌</a>
+                    </td>
+                </tr>
+                {% empty %}
+                <tr>
+                    <td colspan="7" style="text-align: center; color: var(--cinza-claro);">
+                        Nenhuma consulta registrada.
+                    </td>
+                </tr>
+                {% endfor %}
+            </tbody>
+        </table>
+
+        <a href="{% url 'cadastro_consulta' %}" class="btn-nova-consulta">+ AGENDAR NOVA CONSULTA</a>
+    </div>
+</body>
+</html>
